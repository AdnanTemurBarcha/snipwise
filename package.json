{
  "name": "snipwise",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Snipwise - Screenshot & PDF Chrome extension with a full layered editor",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && vite build --mode content",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
